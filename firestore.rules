rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    match /admins/{uid} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /delegates/{delegateId} {
      allow read, delete: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.delegateId == delegateId
        && request.resource.data.id == delegateId
        && delegateId.matches('^[A-Z][0-9]{2}$');
      allow update: if isAdmin()
        && resource.data.delegateId == delegateId
        && resource.data.id == delegateId
        && request.resource.data.delegateId == delegateId
        && request.resource.data.id == delegateId;
    }

    match /team_members/{memberId} {
      allow read, delete: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.memberId == memberId
        && memberId.matches('^[A-Z][0-9]{2}$');
      allow update: if isAdmin()
        && resource.data.memberId == memberId
        && request.resource.data.memberId == memberId;
    }

    match /attendance/{attendanceId} {
      allow read, write: if isAdmin();
    }
  }
}
